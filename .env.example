PORT=3000

# Shopify app "Client secret" (Dev Dashboard / Partners > your app > Client credentials).
# Used to verify that webhooks really come from Shopify.
SHOPIFY_API_SECRET=replace-me

# Optional: Slack incoming webhook URL for team alerts
SLACK_WEBHOOK_URL=

# Optional: SMTP settings for confirmation emails.
# If SMTP_HOST is empty, emails are printed to the console (dry run).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="My Store <orders@example.com>"

# Orders above this total (in the shop currency) trigger a high-priority Slack alert
HIGH_VALUE_THRESHOLD=500

DATABASE_PATH=./data/orders.db
